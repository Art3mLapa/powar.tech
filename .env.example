POSTGRES_PASSWORD=
POSTGRES_USER=bscp
POSTGRES_DB=bscp
DATABASE_URL=postgresql://bscp:replace-with-local-password@127.0.0.1:55439/bscp
# Optional: set these to reuse existing named volumes during an upgrade.
POSTGRES_VOLUME_NAME=
ASSET_STORAGE_VOLUME_NAME=
TOTP_ENCRYPTION_KEY=
WEB_ORIGIN=http://localhost:3000
BACKEND_ORIGIN=http://localhost:3001
STORAGE_DIR=/absolute/path/to/bscp/.runtime/storage
# Optional S3-compatible article media storage. Leave all S3_* values empty to use STORAGE_DIR.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_URL=
# Example for the configured bucket:
# S3_ENDPOINT=https://s3.buckets.ru
# S3_BUCKET=powar.tech
# S3_PUBLIC_URL=https://1e4779d96803dce033b6253930e9b681.bckt.ru/
POSTGRES_PORT=55439
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=3000
CHROMIUM_PATH=/usr/bin/chromium
SCHEDULER_ENABLED=false
AUTH_LINK=
LOGIN=
GLOBAL_AUTH_LINK=
GLOBAL_LOGIN=
# Native renderer spike (worker pulls it as a subprocess on a RENDER job when enabled)
RENDER_SOURCE_ROOT=
RENDERER_EXECUTABLE=
RENDER_HOOKS=
RENDER_TIMEOUT_MS=
RENDER_PUBLISH=false
RENDER_SCHEDULED=false
DO_NOT_TRACK=1
PRISMA_DISABLE_TELEMETRY=1
