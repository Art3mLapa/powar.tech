{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ESNext", "DOM"],
		"module": "Preserve",
		"moduleResolution": "Bundler",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["bun"],
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true
	},
	"include": ["src/**/*.ts", "../../packages/game-assets/src/**/*.ts"]
}
